import { CustomPanel } from "custom.slint";
import { LaunchGroupsPanel, GroupMemberRow } from "launch-groups.slint";
export { GroupMemberRow } from "launch-groups.slint";
import { AboutSlint, Palette } from "std-widgets.slint";
import { ActionButton, AppTile, ContentScroll, Glyph, HomeSection, LauncherItem, PageTransition, PreviewEntry, ResultRow, SurfaceBackground, Theme } from "components.slint";
import { ControlBounds, LicenseEntry, SettingsPanel, SettingsDraft } from "settings.slint";
export { SettingsDraft, ControlBounds, LicenseEntry } from "settings.slint";
export { LauncherItem, PreviewEntry, Theme } from "components.slint";

export component AppWindow inherits Window {
    title: "Velo";
    in property <float> viewport-width: 640;
    in property <float> viewport-height: 540;
    preferred-width: root.viewport-width * 1px;
    preferred-height: root.viewport-height * 1px;
    min-width: root.viewport-width * 1px;
    max-width: root.viewport-width * 1px;
    min-height: root.viewport-height * 1px;
    max-height: root.viewport-height * 1px;
    no-frame: true;
    always-on-top: true;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 12px;

    in property <string> renderer-label;
    in property <string> product-version;
    in property <string> native-status;
    out property <bool> import-open: false;
    out property <bool> groups-open: false;
    in property <[LauncherItem]> group-items;
    in property <[LauncherItem]> group-sources;
    in property <[GroupMemberRow]> group-members;
    in property <[GroupMemberRow]> group-results;
    in-out property <string> group-name;
    in-out property <string> group-aliases;
    in-out property <string> group-filter;
    in-out property <int> group-mode: 0;
    in property <bool> group-busy;
    in property <bool> group-run-busy;
    in property <bool> group-retryable;
    in property <bool> groups-available;
    in property <bool> group-confirm;
    in property <string> group-confirm-text;
    in property <string> group-notice;
    in property <string> group-summary;
    in property <string> group-report-id;
    callback groups-requested(); callback group-new(); callback group-edit(string);
    callback group-delete(string); callback group-save(); callback group-close();
    callback group-add(string); callback group-remove(string); callback group-detect(string);
    callback group-detection-selected(string); callback group-picker-cancelled();
    callback group-retry(); callback group-force(string); callback group-cancel(); callback group-answer(bool);
    callback group-filter-changed(); callback group-draft-changed();
    in property <[PreviewEntry]> preview-entries;
    in property <bool> import-busy: false;
    in property <bool> import-elevated: false;
    in property <bool> drop-hovering: false;
    in property <bool> native-dialog-active: false;
    in property <string> import-summary: "0 项预览";
    in-out property <string> import-notice;
    in-out property <string> import-path;
    in property <int> item-count;
    in property <bool> business-enabled: false;
    in property <bool> scanning: false;
    in property <string> business-status;
    in property <bool> space-launch: false;
    in property <int> business-revision: 0;
    in property <bool> grid-results: false;
    in property <bool> management-busy: false;
    in property <[LauncherItem]> custom-items;
    in-out property <SettingsDraft> settings-draft;
    in-out property <int> settings-tab: 0;
    in property <string> settings-notice;
    in property <string> backup-path;
    in property <string> data-directory;
    in property <[LicenseEntry]> third-party-licenses;
    out property <bool> licenses-expanded: settings.licenses-expanded;
    pure callback hotkey-parts(string) -> [string];
    pure callback item-pinnable(string) -> bool;
    item-pinnable(id) => { return true; }
    in property <string> update-message;
    in property <string> update-notes;
    in property <int> update-progress;
    in property <bool> update-busy: false;
    in property <bool> update-available: false;
    in-out property <bool> import-return-settings: false;
    private property <bool> group-return-settings: false;
    in property <[LauncherItem]> pinned-items;
    in property <[LauncherItem]> frequent-items;
    in property <[LauncherItem]> system-items;
    in property <int> system-total-count;
    in-out property <bool> all-system-tools: false;
    callback system-expansion-changed();
    in property <[LauncherItem]> result-items;
    in-out property <string> input-text;
    in-out property <string> selected-id;
    in-out property <string> selection-notice;
    in-out property <bool> is-home: true;
    in-out property <bool> dark-theme <=> Theme.dark;
    in-out property <bool> reduce-motion <=> Theme.reduce-motion;
    out property <bool> appearance-open: false;
    in property <bool> native-composing: false;
    in property <bool> native-focused: false;
    in-out property <bool> presented <=> Theme.presented;
    in property <bool> lifecycle-enabled: false;
    in property <string> hotkey-current;
    in property <string> hotkey-error;
    in property <string> platform-error;
    in-out property <string> hotkey-draft: "Alt+Space";
    in property <bool> hotkey-recording: false;
    in-out property <bool> disable-hotkey-fullscreen: true;
    out property <bool> input-has-focus: input.has-focus;
    out property <bool> has-preedit: input.preedit-text != "";
    in-out property <length> home-scroll-y <=> home.content-y;
    in-out property <length> result-scroll-y <=> results.content-y;
    in-out property <length> import-scroll-y <=> custom-panel.scroll-y;
    in-out property <length> settings-scroll-y <=> settings.scroll-y;
    callback input-edited(string);
    callback backend-changed();
    callback refresh-requested();
    callback icon-viewport-changed();
    callback item-chosen(string);
    callback quit-requested();
    callback hide-requested();
    callback global-hotkey(string);
    callback desktop-event(int);
    callback layout-changed();
    callback drag-requested();
    callback hotkey-apply(string);
    callback hotkey-record(bool);
    callback key-requested(string, bool, bool) -> bool;
    callback input-focus-changed(bool);
    callback import-path-requested(string);
    callback import-preview-ready(int, [PreviewEntry]);
    callback import-native-requested(int);
    callback import-native-completed(int, [string], string);
    callback native-interaction-finished();
    callback launch-started();
    callback launch-finished(bool);
    callback settings-requested();
    callback settings-save();
    callback hotkey-committed(string);
    callback application-menu(string);
    callback application-menu-completed(string, int);
    callback application-delete(string);
    callback import-commit();
    callback backup-requested(bool);
    callback update-requested(bool);
    callback environment-changed();
    callback startup-configuration-ready(bool);
    public function icon-visible(group: int, index: int) -> bool {
        if group == 5 { return root.presented && root.groups-open && groups-panel.icon-visible(index); }
        if group == 4 { return root.presented && root.import-open && custom-panel.icon-visible(index); }
        if !root.presented || root.appearance-open || root.import-open || root.groups-open { return false; }
        if group == 3 {
            if root.grid-results { return !root.is-home && 16px + Math.floor(index / 6) * 106px + 89px > -results.content-y && 16px + Math.floor(index / 6) * 106px < -results.content-y + results.height; }
            return !root.is-home && 6px + index * 54px + 54px > -results.content-y && 6px + index * 54px < -results.content-y + results.height;
        }
        if !root.is-home { return false; }
        return (group == 0 ? pinned.y : group == 1 ? frequent.y : system.y) + 26px + Math.floor(index / 6) * 96px + 89px > -home.content-y
            && (group == 0 ? pinned.y : group == 1 ? frequent.y : system.y) + 26px + Math.floor(index / 6) * 96px < -home.content-y + home.height;
    }
    public function focus-input() {
        if root.presented && !root.native-dialog-active {
            if root.groups-open { groups-panel.focus-panel(); }
            else if root.import-open { custom-panel.focus-panel(); }
            else if !root.appearance-open { input.focus(); }
        }
    }
    public function suspend-input() { parking-focus.focus(); }
    public function settings-geometry() -> [ControlBounds] { return settings.control-bounds(); }
    public function show-licenses(open: bool) { settings.show-licenses(open); }
    public function show-appearance(open: bool) {
        if open && !root.appearance-open && root.business-enabled { root.settings-requested(); }
        if open { root.import-open = false; root.groups-open = false; }
        root.appearance-open = open;
        if open { if root.business-enabled { settings.focus-panel(); } else { appearance-focus.focus(); } } else { input.focus(); }
    }
    public function show-import(open: bool) {
        if open { root.appearance-open = false; root.groups-open = false; root.hotkey-record(false); }
        root.import-open = open;
        if !open && root.import-return-settings { root.import-return-settings = false; root.appearance-open = true; settings.focus-panel(); return; }
        if root.presented {
            if open { custom-panel.focus-panel(); } else { root.focus-input(); }
        }
    }
    public function show-groups(open: bool) {
        if open && !root.groups-open { root.group-return-settings = root.appearance-open; }
        if open { root.appearance-open = false; root.import-open = false; root.hotkey-record(false); }
        root.groups-open = open;
        if !open && root.group-return-settings { root.group-return-settings = false; root.appearance-open = true; settings.focus-panel(); return; }
        if open { root.groups-requested(); groups-panel.focus-panel(); } else { root.focus-input(); }
    }
    public function clear-input() {
        root.input-text = "";
        root.input-edited("");
        input.focus();
    }
    public function ensure-selection-visible(index: int) {
        if root.is-home {
            if index < root.pinned-items.length {
                home.ensure-visible(pinned.y + 26px + Math.floor(index / 6) * 96px, 89px);
            } else if index < root.pinned-items.length + root.frequent-items.length {
                home.ensure-visible(frequent.y + 26px + Math.floor((index - root.pinned-items.length) / 6) * 96px, 89px);
            } else {
                home.ensure-visible(system.y + 26px + Math.floor((index - root.pinned-items.length - root.frequent-items.length) / 6) * 96px, 89px);
            }
        } else {
            results.ensure-visible(root.grid-results ? 16px + Math.floor(index / 6) * 106px : 6px + index * 54px, root.grid-results ? 89px : 54px);
        }
    }
    init => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed dark-theme => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed input-text => { results.content-y = 0px; }
    changed all-system-tools => { root.system-expansion-changed(); }
    changed input-has-focus => { root.input-focus-changed(root.input-has-focus); }
    changed appearance-open => { if !root.appearance-open { root.hotkey-record(false); } root.layout-changed(); root.icon-viewport-changed(); }
    changed import-open => { root.layout-changed(); root.icon-viewport-changed(); }
    changed groups-open => { root.layout-changed(); root.icon-viewport-changed(); }
    changed group-mode => { root.icon-viewport-changed(); }
    changed group-filter => { root.group-filter-changed(); }
    changed group-name => { root.group-draft-changed(); }
    changed group-aliases => { root.group-draft-changed(); }
    changed presented => { root.icon-viewport-changed(); }
    changed home-scroll-y => { root.icon-viewport-changed(); }
    changed result-scroll-y => { root.icon-viewport-changed(); }
    changed viewport-height => { root.icon-viewport-changed(); }

    // Capture commands before TextInput's cursor navigation. Other keys retain
    // normal text editing, and buttons keep their own Enter/Space semantics.
    FocusScope {
        width: parent.width; height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.key-requested(event.text, event.modifiers.control || event.modifiers.alt || event.modifiers.meta || event.modifiers.shift, event.repeat) {
                return accept;
            }
            return reject;
        }
        SurfaceBackground { width: parent.width; height: parent.height; }
        TouchArea { clicked => { root.focus-input(); } }
        parking-focus := FocusScope { focus-on-click: false; focus-on-tab-navigation: false; }

        Rectangle {
            x: 0px; y: 0px; width: parent.width;
            height: 79px; background: Theme.surface;
            // Background only: later input/buttons consume their own pointer events.
            TouchArea {
                enabled: root.lifecycle-enabled && !root.appearance-open && !root.import-open;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-requested(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            Image { x: 21px; y: 23px; width: 36px; height: 36px; source: @image-url("assets/logo.png"); image-fit: contain; }
            Rectangle {
                x: 70px; y: 18px; width: parent.width - 136px; height: 44px;
                border-radius: 10px;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.border;
                background: Theme.field;
                if input.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-radius: 13px; border-width: 3px; border-color: Theme.selected; }
                animate border-color { duration: Theme.reduce-motion ? 0ms : 180ms; }
                Glyph { x: 12px; y: 13px; width: 17px; height: 17px; icon-key: "search"; }
                Text {
                    x: 39px; width: parent.width - 92px; height: 44px;
                    text: input.text == "" && input.preedit-text == "" ? "搜索应用与系统功能…" : "";
                    font-size: 15px; color: Theme.muted; vertical-alignment: center;
                }
                input := TextInput {
                    x: 39px; y: 10px; width: parent.width - 92px; height: 24px;
                    text <=> root.input-text;
                    single-line: true;
                    enabled: root.presented && !root.appearance-open && !root.import-open && !root.native-dialog-active;
                    font-size: 15px; color: Theme.fg;
                    selection-background-color: Theme.selected;
                    selection-foreground-color: Theme.fg;
                    edited => { root.input-edited(self.text); }
                    accessible-label: "搜索应用与系统功能";
                }
                if !root.business-enabled && root.input-text != "": ActionButton {
                    x: parent.width - 42px; y: 9px; width: 32px; height: 26px;
                    text: "清空";
                    enabled: !root.appearance-open;
                    activated => { root.clear-input(); }
                }
                if root.business-enabled || root.input-text == "": Text {
                    x: parent.width - 39px; y: 14px; width: 30px; height: 18px;
                    text: "搜索"; font-size: 10px; color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
            ActionButton {
                x: parent.width - 54px; y: 23px; width: 34px; height: 34px;
                text: root.business-enabled ? "设置" : "外观与关于"; icon-key: "settings";
                rotate-on-hover: true; flat: root.business-enabled;
                checked: root.appearance-open;
                enabled: !root.appearance-open;
                activated => { root.show-appearance(!root.appearance-open); }
            }
        }

        home := ContentScroll {
            reserve-scrollbar: true;
            visible: root.is-home;
            private property <float> entry: root.presented && root.is-home ? 1 : 0;
            animate entry { duration: Theme.reduce-motion ? 0ms : 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            opacity: Theme.reduce-motion ? 1 : self.entry;
            x: 0px; y: 79px + (Theme.reduce-motion ? 0px : (1 - self.entry) * 5px); width: parent.width; height: parent.height - 122px;
            content-height: home-body.height;
            home-body := Rectangle {
                // Flickable centers an undersized child unless its origin is
                // explicit; removing a pinned group must not move the heading.
                x: 0px; y: 0px;
                width: home.visible-width;
                height: system.y + system.height + 18px;
                background: transparent;
                Text { x: 24px; y: 25px; text: "VELO / 快速启动"; font-size: 9px; font-weight: 600; color: Theme.muted; letter-spacing: 1.8px; }
                Text { x: 24px; y: 44px; text: "即刻，开启所想"; font-size: 23px; font-weight: 600; color: Theme.fg; }
                Text { x: 185px; y: 44px; text: "."; font-size: 23px; font-weight: 600; color: Theme.accent; }
                if root.business-enabled: ActionButton {
                    x: parent.width - 120px; y: 35px; width: 96px; height: 32px;
                    text: "+ 自定义应用"; show-shadow: true;
                    activated => { root.show-import(true); }
                }
                if root.business-enabled: ActionButton { x: parent.width - 228px; y: 35px; width: 98px; height: 32px; text: "启动组合"; activated => { root.show-groups(true); } }
                pinned := HomeSection {
                    x: 22px; y: 98px; width: parent.width - 44px;
                    title: "已固定"; items: root.pinned-items;
                    height: root.pinned-items.length == 0 ? 0px : 26px + Math.ceil(root.pinned-items.length / 6) * 96px - 7px;
                    visible: root.pinned-items.length > 0;
                    selected-id: root.selected-id;
                    entered: root.presented && root.is-home;
                    hovered(id) => { root.selected-id = id; }
                    chosen(id) => { root.item-chosen(id); }
                    context-menu(id) => { root.application-menu(id); }
                    pin-toggled(id) => { root.application-menu-completed(id, 4); }
                }
                frequent := HomeSection {
                    x: 22px; y: pinned.y + pinned.height + (root.pinned-items.length > 0 ? 20px : 0px); width: parent.width - 44px;
                    title: "常用应用"; hint: "根据使用习惯与应用来源排序";
                    empty-message: root.scanning ? "正在发现本机应用…" : "搜索应用，或拖入你的第一个应用。";
                    items: root.frequent-items; selected-id: root.selected-id;
                    entered: root.presented && root.is-home;
                    hovered(id) => { root.selected-id = id; }
                    chosen(id) => { root.item-chosen(id); }
                    context-menu(id) => { root.application-menu(id); }
                    pin-toggled(id) => { root.application-menu-completed(id, 4); }
                }
                system := HomeSection {
                    x: 22px; y: frequent.y + frequent.height + 20px; width: parent.width - 44px;
                    title: "系统快捷";
                    expandable: root.business-enabled && root.system-total-count > 12; expanded: root.all-system-tools; total-count: root.business-enabled ? root.system-total-count : root.system-items.length;
                    expansion-toggled => { root.all-system-tools = !root.all-system-tools; }
                    items: root.system-items; selected-id: root.selected-id;
                    entered: root.presented && root.is-home;
                    hovered(id) => { root.selected-id = id; }
                    chosen(id) => { root.item-chosen(id); }
                    context-menu(id) => { root.application-menu(id); }
                    pin-toggled(id) => { root.application-menu-completed(id, 4); }
                }
            }
        }

        results := ContentScroll {
            reserve-scrollbar: true;
            visible: !root.is-home && root.result-items.length > 0;
            private property <float> entry: root.presented && !root.is-home ? 1 : 0;
            animate entry { duration: Theme.reduce-motion ? 0ms : 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            opacity: Theme.reduce-motion ? 1 : self.entry;
            x: 0px; y: 79px + (Theme.reduce-motion ? 0px : (1 - self.entry) * 5px); width: parent.width; height: parent.height - 122px;
            content-height: root.grid-results ? Math.ceil(root.result-items.length / 6) * 108px + 28px : root.result-items.length * 54px + 12px;
            if !root.grid-results: Rectangle {
            x: 0px; y: 0px;
            width: results.visible-width; height: results.content-height;
            for item[index] in root.result-items: ResultRow {
                pinnable: root.item-pinnable(item.id);
                x: 12px; y: 6px + index * 54px; width: results.visible-width - 24px;
                item: item; selected: root.selected-id == item.id;
                hovered(id) => { root.selected-id = id; }
                chosen(id) => { root.item-chosen(id); }
                context-menu(id) => { root.application-menu(id); }
                    pin-toggled(id) => { root.application-menu-completed(id, 4); }
            }
            }
            if root.grid-results: Rectangle {
                x: 0px; y: 0px;
                width: results.visible-width; height: results.content-height;
                for item[index] in root.result-items: AppTile {
                    pinnable: root.item-pinnable(item.id);
                    x: 16px + Math.mod(index,6) * ((parent.width - 32px + 8px) / 6); y: 18px + Math.floor(index / 6) * 108px;
                    width: (parent.width - 32px - 40px) / 6;
                    grid: true;
                    item: item; selected: root.selected-id == item.id; entered: true; animate-entry: false;
                    hovered(id) => { root.selected-id = id; }
                    chosen(id) => { root.item-chosen(id); }
                    context-menu(id) => { root.application-menu(id); }
                    pin-toggled(id) => { root.application-menu-completed(id, 4); }
                }
            }
        }

        if !root.is-home && root.result-items.length == 0: Rectangle {
            x: 0px; y: 79px; width: parent.width; height: parent.height - 122px;
            background: transparent;
            if !root.business-enabled: Glyph { x: 24px; y: 16px; width: 24px; height: 24px; icon-key: "search"; }
            Text { y: 10px; height: 26px; width: parent.width; text: "没有找到匹配的应用"; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
            if !root.business-enabled: ActionButton { x: (parent.width - 100px) / 2; y: 44px; width: 100px; height: 28px; text: "清空搜索"; activated => { root.clear-input(); } }
        }

        Rectangle {
            x: 0px; y: parent.height - 43px; width: parent.width; height: 43px; background: Theme.surface;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
            Rectangle { x: 20px; y: 19px; width: 5px; height: 5px; border-radius: 3px; background: Theme.accent; }
            Text { x: 31px; height: parent.height; width: max(0px, footer-actions.x - self.x - 12px); font-size: 10px; color: Theme.muted; vertical-alignment: center; overflow: elide;
                text: root.platform-error != "" ? root.platform-error : root.hotkey-error != "" ? "快捷键不可用，请打开设置" : root.selection-notice != "" ? root.selection-notice : root.scanning ? "正在更新索引…" : root.item-count + " 个应用就绪"; }
            // Reserve each visible group's natural width before the status elides.
            // Space and custom-app actions must not share a fixed right offset.
            footer-actions := HorizontalLayout {
                x: parent.width - self.width - 20px; y: 12px;
                width: self.preferred-width; height: 19px; spacing: 12px;
                HorizontalLayout {
                    width: self.preferred-width; height: 19px; spacing: 4px;
                    for key in (!root.is-home && root.grid-results ? ["↑", "↓", "←", "→"] : ["↑", "↓"]): Rectangle { width: 18px; height: 19px; border-radius: 4px; border-width: 1px; border-color: Theme.border; background: Theme.field; Text { text: key; color: Theme.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                    Text { text: "选择"; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { width: 18px; height: 19px; border-radius: 4px; border-width: 1px; border-color: Theme.border; background: Theme.field; Glyph { x: 3px; y: 3px; width: 12px; height: 12px; icon-key: "enter"; colorize: Theme.muted; } }
                    if root.space-launch: Rectangle { width: 38px; height: 19px; border-radius: 4px; border-width: 1px; border-color: Theme.border; background: Theme.field; Text { text: "Space"; color: Theme.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                    Text { text: "启动"; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { width: 25px; height: 19px; border-radius: 4px; border-width: 1px; border-color: Theme.border; background: Theme.field; Text { text: "Esc"; color: Theme.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                    Text { text: root.input-text == "" ? "隐藏" : "清空"; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-stretch: 0; }
                }
                if !root.is-home: ActionButton { width: 60px; height: 19px; text: "自定义应用"; text-size: 10px; flat: true; activated => { root.show-import(true); } }
                ActionButton { width: 20px; height: 19px; text: "刷新索引"; icon-key: "refresh"; flat: true; spinning: root.scanning && !root.appearance-open && !root.import-open; activated => { root.refresh-requested(); } }
            }
        }

        PageTransition {
            open: root.import-open; presented: root.presented;
            width: parent.width; height: parent.height;
            custom-panel := CustomPanel {
                width: parent.width; height: parent.height;
                enabled: root.presented && root.import-open && !root.native-dialog-active;
                items: root.custom-items; previews: root.preview-entries; path <=> root.import-path;
                busy: root.management-busy; import-busy: root.import-busy; elevated: root.import-elevated;
                drop-hovering: root.drop-hovering; notice: root.import-notice; summary: root.import-summary;
                close => { root.show-import(false); } browse => { root.import-native-requested(1); }
                preview(path) => { root.import-path-requested(path); } commit => { root.import-commit(); }
                remove(id) => { root.application-delete(id); } menu(id) => { root.application-menu(id); }
                drag => { root.drag-requested(); } more => { root.import-native-requested(4); }
                viewport-changed => { root.icon-viewport-changed(); }
            }
        }

        PageTransition {
            open: root.groups-open; presented: root.presented;
            width: parent.width; height: parent.height;
            groups-panel := LaunchGroupsPanel {
                width: parent.width; height: parent.height;
                enabled: root.presented && root.groups-open && !root.native-dialog-active;
                groups: root.group-items; sources: root.group-sources; members: root.group-members; results: root.group-results;
                name <=> root.group-name; aliases <=> root.group-aliases; filter <=> root.group-filter; mode <=> root.group-mode;
                busy: root.group-busy; run-busy: root.group-run-busy; retryable: root.group-retryable; available: root.groups-available;
                notice: root.group-notice; summary: root.group-summary; confirm: root.group-confirm; confirm-text: root.group-confirm-text;
                report-id: root.group-report-id;
                close => { root.group-close(); } create => { root.group-new(); } edit(id) => { root.group-edit(id); } remove-group(id) => { root.group-delete(id); }
                save => { root.group-save(); } add(id) => { root.group-add(id); } remove(id) => { root.group-remove(id); }
                detect(id) => { root.group-detect(id); }
                viewport-changed => { root.icon-viewport-changed(); }
                retry => { root.group-retry(); } force(id) => { root.group-force(id); } cancel => { root.group-cancel(); } answer(yes) => { root.group-answer(yes); }
                drag => { root.drag-requested(); }
            }
        }

        Rectangle {
            private property <float> progress: root.appearance-open ? 1 : 0;
            private property <length> offset: root.appearance-open ? 0px : 8px;
            animate progress { duration: Theme.reduce-motion ? 0ms : root.appearance-open ? 220ms : 100ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            animate offset { duration: Theme.reduce-motion ? 0ms : 280ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            visible: !root.business-enabled && (root.appearance-open || self.progress > 0);
            opacity: Theme.reduce-motion ? (root.appearance-open ? 1 : 0) : self.progress;
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            // Dismiss surface prevents clicks reaching tiles behind the panel.
            background: transparent;
            TouchArea { clicked => { root.show-appearance(false); } }
            appearance-focus := FocusScope {
                enabled: root.presented && root.appearance-open;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                x: max(16px, root.width - self.width - 20px);
                y: 72px + (Theme.reduce-motion ? 0px : parent.offset);
                width: min(322px, root.width - 32px);
                height: min(root.lifecycle-enabled ? 452px : 332px, max(1px, root.height - self.y - 12px));
                ContentScroll {
                    width: parent.width; height: parent.height;
                    content-height: appearance-body.height;
                    appearance-body := Rectangle {
                    width: parent.visible-width; height: root.lifecycle-enabled ? 452px : 332px;
                    background: Theme.field; border-color: Theme.border; border-width: 1px; border-radius: 12px;
                    TouchArea { }
                    Text { x: 18px; y: 16px; text: "外观与关于"; color: Theme.fg; font-size: 16px; font-weight: 600; }
                    ActionButton { x: 258px; y: 10px; width: 48px; text: "关闭"; activated => { root.show-appearance(false); } }
                    ActionButton { x: 18px; y: 54px; width: 138px; text: "浅色"; checked: !root.dark-theme; activated => { root.dark-theme = false; } }
                    ActionButton { x: 164px; y: 54px; width: 138px; text: "深色"; checked: root.dark-theme; activated => { root.dark-theme = true; } }
                    Text { x: 18px; y: 106px; height: 30px; text: "减少动画"; color: Theme.fg; vertical-alignment: center; }
                    ActionButton { x: 226px; y: 102px; width: 76px; text: root.reduce-motion ? "已开启" : "已关闭"; checked: root.reduce-motion; checkable: true; activated => { root.reduce-motion = !root.reduce-motion; } }
                    if root.lifecycle-enabled: Rectangle {
                        x: 18px; y: 144px; width: 286px; height: 120px;
                        Text { x: 0px; y: 0px; width: 286px; height: 18px; text: root.hotkey-current == "" ? "全局快捷键不可用" : "当前快捷键：" + root.hotkey-current; color: Theme.fg; font-size: 11px; }
                        Rectangle {
                            y: 22px; width: 162px; height: 29px; border-radius: 5px;
                            background: Theme.bg; border-color: Theme.border; border-width: 1px;
                            TextInput {
                                x: 7px; y: 5px; width: 148px; height: 19px;
                                text <=> root.hotkey-draft; single-line: true; color: Theme.fg;
                                enabled: !root.hotkey-recording;
                                accessible-label: "全局快捷键";
                            }
                        }
                        ActionButton { x: 168px; y: 22px; width: 56px; height: 29px; text: root.hotkey-recording ? "取消" : "录制"; activated => { root.hotkey-record(!root.hotkey-recording); } }
                        ActionButton { x: 230px; y: 22px; width: 56px; height: 29px; text: "应用"; enabled: !root.hotkey-recording; activated => { root.hotkey-apply(root.hotkey-draft); } }
                        Text { y: 56px; width: 286px; height: 30px; text: root.hotkey-recording ? "请按快捷键；Esc 取消" : root.hotkey-error; color: Theme.muted; font-size: 10px; wrap: word-wrap; overflow: elide; }
                        Text { x: 0px; y: 89px; width: 200px; height: 27px; text: "全屏时禁用呼出"; color: Theme.fg; font-size: 11px; vertical-alignment: center; }
                        ActionButton { x: 210px; y: 88px; width: 76px; height: 28px; text: root.disable-hotkey-fullscreen ? "已开启" : "已关闭"; activated => { root.disable-hotkey-fullscreen = !root.disable-hotkey-fullscreen; } }
                    }
                    Text { x: 18px; y: root.lifecycle-enabled ? 266px : 146px; width: 286px; text: root.renderer-label; color: Theme.muted; font-size: 10px; overflow: elide; }
                    // Official, accessible attribution required by the selected Slint license.
                    AboutSlint { x: 18px; y: root.lifecycle-enabled ? 296px : 176px; width: 286px; height: 138px; }
                    }
                }
            }
        }
        PageTransition {
            open: root.business-enabled && root.appearance-open;
            presented: root.presented;
            width: parent.width; height: parent.height;
        settings := SettingsPanel {
            x: 0px; y: 0px;
            enabled: root.presented && root.appearance-open && !root.native-dialog-active;
            width: parent.width; height: parent.height;
            draft <=> root.settings-draft; hotkey <=> root.hotkey-draft; tab <=> root.settings-tab;
            current-hotkey: root.hotkey-current; hotkey-keys: root.hotkey-parts(root.hotkey-draft); hotkey-error: root.hotkey-error; recording: root.hotkey-recording;
            busy: root.management-busy; notice: root.settings-notice;
            backup-path: root.backup-path; data-directory: root.data-directory; count: root.item-count;
            scanning: root.scanning; scan-status: root.business-status; renderer: root.renderer-label; product-version: root.product-version; licenses: root.third-party-licenses;
            update-message: root.update-message; update-notes: root.update-notes; update-available: root.update-available; update-busy: root.update-busy; update-progress: root.update-progress;
            close => { if !root.management-busy { root.show-appearance(false); } }
            save => { root.settings-save(); }
            record(enabled) => { root.hotkey-record(enabled); }
            manage => { root.import-return-settings = true; root.show-import(true); }
            groups => { root.show-groups(true); }
            refresh => { root.refresh-requested(); }
            backup => { root.backup-requested(false); }
            open-backups => { root.backup-requested(true); }
            check-update => { root.update-requested(false); }
            install-update => { root.update-requested(true); }
            drag => { root.drag-requested(); }
        }
        }
    }
    forward-focus: input;
}
