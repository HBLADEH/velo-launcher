import { ContentScroll, Glyph, Theme } from "components.slint";

export struct LicenseEntry { title: string, text: string }

export component HotkeyCaps {
    in property <[string]> keys;
    HorizontalLayout {
        alignment: start; spacing: 7px;
        for key[index] in root.keys: HorizontalLayout {
            spacing: 7px;
            if index > 0: Text { text: "+"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
            Rectangle {
                width: max(36px, label.preferred-width + 18px); height: 32px;
                border-radius: 6px; background: Theme.field; border-width: 1px; border-color: Theme.border;
                Rectangle { y: parent.height - 2px; width: parent.width; height: 2px; border-radius: 1px; background: Theme.border; }
                label := Text { text: key; width: parent.width; height: parent.height; font-size: 13px; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

export component SettingLabel inherits Text {
    font-size: 13px; color: Theme.fg; height: 17px;
}

export component SettingHint inherits Text {
    font-size: 12px; color: Theme.muted; wrap: word-wrap;
    line-height-factor: 1.8;
}

export component SettingHeading inherits Text {
    font-size: 17px; font-weight: 700; color: Theme.fg; height: 22px;
}

// Explicit bounds follow the final Wails CSS, rather than Fluent's minimum
// layout sizes. TextInput still owns native text editing and IME composition.
export component SettingField inherits FocusScope {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <bool> numeric: false;
    in property <bool> read-only: false;
    height: 37px;
    Rectangle {
        width: parent.width; height: parent.height; border-radius: 8px;
        border-width: 1px; border-color: edit.has-focus ? Theme.accent : area.has-hover ? Theme.accent-line : Theme.border;
        background: Theme.field;
        animate border-color { duration: Theme.reduce-motion ? 0ms : 160ms; }
        TouchArea { enabled: root.enabled; clicked => { edit.focus(); } }
        Text { x: 11px; y: 10px; text: root.text == "" ? root.placeholder : ""; color: Theme.muted; font-size: 13px; }
        scroll := ContentScroll {
            x: 11px; y: 10px; width: parent.width - 22px; height: parent.height - 20px;
            enabled: root.enabled; content-height: root.multiline ? max(self.height, edit.preferred-height) : self.height;
            edit := TextInput {
                x: 0px; y: 0px; width: scroll.width; height: root.multiline ? max(scroll.height, self.preferred-height) : scroll.height;
                text <=> root.text; single-line: !root.multiline; wrap: root.multiline ? word-wrap : no-wrap;
                input-type: root.numeric ? InputType.number : InputType.text;
                font-size: 13px; color: Theme.fg; read-only: root.read-only; enabled: root.enabled;
                selection-background-color: Theme.selected; selection-foreground-color: Theme.fg;
                accessible-label: root.label;
                cursor-position-changed(point) => { scroll.ensure-visible(point.y, 18px); }
            }
        }
        area := TouchArea { enabled: false; }
    }
    forward-focus: edit;
}

export component SettingCheck inherits FocusScope {
    in-out property <bool> checked;
    in property <string> text;
    height: 20.8px;
    Rectangle {
        x: 0px; y: 1.4px; width: 18px; height: 18px;
        border-width: 1px; border-radius: 5px;
        background: root.checked ? Theme.accent : Theme.field;
        border-color: root.checked || root.has-focus ? Theme.accent : Theme.muted;
        animate background, border-color { duration: Theme.reduce-motion ? 0ms : 160ms; }
        if root.checked: Glyph { x: 1px; y: 1px; width: 14px; height: 14px; icon-key: "check"; colorize: Theme.bg; }
    }
    Text { x: 28px; y: 0px; height: 20.8px; width: parent.width - 28px; text: root.text; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.focus(); root.checked = !root.checked; } }
    key-pressed(event) => {
        if event.text == " " || event.text == "\n" { root.checked = !root.checked; return accept; }
        return reject;
    }
    accessible-role: checkbox; accessible-label: root.text; accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; } }
}

export component SettingSelect inherits FocusScope {
    in property <[string]> options;
    in property <[string]> descriptions;
    in property <string> label;
    in property <bool> above: false;
    in-out property <int> current-index;
    private property <int> active;
    private property <bool> expanded;
    private property <float> progress: root.expanded ? 1 : 0;
    private property <float> geometry-progress: root.expanded ? 1 : 0;
    animate progress { duration: Theme.reduce-motion ? 0ms : 140ms; easing: ease; }
    animate geometry-progress { duration: Theme.reduce-motion ? 0ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    height: 44px;
    public function reveal() {
        root.active = root.current-index; close-timer.running = false;
        // Evaluate the resting opacity before showing the lazy popup content.
        if root.progress >= 0 && root.geometry-progress >= 0 { popup.show(); }
        root.expanded = true;
    }
    function dismiss() { root.expanded = false; if Theme.reduce-motion { popup.close(); } else { close-timer.running = true; } root.focus(); }
    function choose(index: int) { root.current-index = index; root.dismiss(); }
    close-timer := Timer { interval: 180ms; running: false; triggered => { self.running = false; popup.close(); } }
    Rectangle {
        width: parent.width; height: parent.height; border-radius: 6px; border-width: 1px;
        border-color: root.expanded || root.has-focus ? Theme.accent : Theme.border; background: Theme.field;
        Text { x: 15px; y: 0px; width: parent.width - 52px; height: parent.height; text: root.options[root.current-index]; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
        Glyph { x: parent.width - 30px; y: 14px; width: 16px; height: 16px; icon-key: "chevron"; colorize: Theme.muted; }
        TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.reveal(); } }
    }
    key-pressed(event) => { if event.text == " " || event.text == "\n" || event.text == Key.DownArrow { root.reveal(); return accept; } return reject; }
    popup := PopupWindow {
        x: 0px; y: root.above ? -self.height - 6px : root.height + 6px;
        width: root.width; height: root.options.length * 54px + 12px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            width: parent.width; height: parent.height;
            focus-changed-event => { if !self.has-focus { root.expanded = false; } }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Tab { root.dismiss(); return accept; }
                if event.text == Key.DownArrow { root.active = Math.mod(root.active + 1, root.options.length); return accept; }
                if event.text == Key.UpArrow { root.active = Math.mod(root.active + root.options.length - 1, root.options.length); return accept; }
                if event.text == Key.Home { root.active = 0; return accept; }
                if event.text == Key.End { root.active = root.options.length - 1; return accept; }
                if event.text == "\n" || event.text == " " { root.choose(root.active); return accept; }
                return reject;
            }
            Rectangle {
                private property <float> scale: 0.98 + root.geometry-progress * 0.02;
                opacity: root.progress;
                x: parent.width * (1 - self.scale) / 2;
                y: (root.above ? parent.height * (1 - self.scale) : 0px) + (1 - root.geometry-progress) * (root.above ? 4px : -4px);
                width: parent.width * self.scale; height: parent.height * self.scale; background: Theme.field; border-radius: 12px; border-width: 1px; border-color: Theme.border;
                for option[index] in root.options: Rectangle {
                    x: 6px; y: (6px + index * 54px) * parent.scale; width: parent.width - 12px; height: 54px * parent.scale; border-radius: 7px;
                    background: index == root.active ? Theme.hover : transparent; border-width: 1px; border-color: index == root.active ? Theme.border : transparent;
                    Text { x: 13px; y: 9px; text: option; font-size: 13px; color: index == root.current-index ? Theme.accent : Theme.fg; }
                    Text { x: 13px; y: 29px; width: parent.width - 48px; text: root.descriptions[index]; font-size: 11px; color: Theme.muted; overflow: elide; }
                    if index == root.current-index: Glyph { x: parent.width - 28px; y: 18px; width: 18px; height: 18px; icon-key: "check"; }
                    TouchArea { moved => { root.active = index; } clicked => { root.choose(index); } }
                }
            }
        }
    }
    accessible-role: combobox; accessible-label: root.label; accessible-expandable: true; accessible-expanded: root.expanded;
    accessible-value: root.options[root.current-index]; accessible-action-expand => { root.reveal(); }
}

export component ThemePreview inherits Rectangle {
    in property <int> theme;
    private property <bool> dark: root.theme == 2 || (root.theme == 0 && Theme.dark);
    height: 172px; border-width: 1px; border-color: Theme.border; border-radius: 14px; background: Theme.surface;
    Rectangle {
        x: 25px; y: 25px; width: 170px; height: 122px; border-radius: 11px; border-width: 1px;
        border-color: root.dark ? #365575 : #d4e3f5; background: root.dark ? #17283e : #f6f9ff;
        Rectangle { x: 15px; y: 15px; width: 140px; height: 23px; border-radius: 5px; border-width: 1px; border-color: #b6d8ff; background: root.dark ? #22374f : white;
            Rectangle { x: 7px; y: 7px; width: 9px; height: 9px; border-radius: 5px; border-width: 2px; border-color: #0078d4; }
            Rectangle { x: 24px; y: 9px; width: 68px; height: 4px; background: #d5deea; }
        }
        for index in 6: Rectangle { x: 15px + Math.mod(index,3) * 49px; y: 49px + Math.floor(index/3)*33px; width: 42px; height: 26px; border-radius: 5px; background: index == 0 ? #0078d4 : root.dark ? #263c57 : #e5ecfa; }
    }
    Text { x: 219px; y: 51px; text: "Windows 蓝"; font-size: 16px; font-weight: 700; color: Theme.fg; }
    Text { x: 219px; y: 81px; text: "轻盈层次，流畅随行。"; font-size: 12px; color: Theme.muted; }
    Text { x: 219px; y: 109px; text: "动效跟随系统的减少动画偏好"; font-size: 10px; color: Theme.muted; }
}
