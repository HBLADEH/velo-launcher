# 行尾统一为 LF：验证脚本直接跑 gofmt -l，CRLF 会被判为未格式化
* text=auto eol=lf
*.png binary
*.ico binary
*.exe binary

# Slint evidence manifests hash original bytes, including captured line endings.
docs/baselines/2026-10-28-slint-rs*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/baselines/2026-10-29-slint-rs07/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Acceptance manifests and third-party provenance hash exact original bytes.
docs/baselines/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
rust/licenses/** -text -whitespace
rust/ui/assets/fluent/LICENSE.txt -text whitespace=cr-at-eol
tests/fixtures/compat/** -text whitespace=cr-at-eol
