import { AboutSlint } from "std-widgets.slint";
import { ActionButton, ContentScroll, Glyph, SurfaceBackground, Theme } from "components.slint";
import { HotkeyCaps, LicenseEntry, SettingCheck, SettingField, SettingHeading, SettingHint, SettingLabel, SettingSelect, ThemePreview } from "settings-controls.slint";
import { WorkspaceEditorState, WorkspaceSettings } from "workspace-settings.slint";
export { LicenseEntry } from "settings-controls.slint";

export struct SettingsDraft {
    startup: bool, space: bool, maximum: string, fullscreen: bool, everything: bool, everything-executable: string,
    theme: int, layout: int, fuzzy: bool, weight: string,
    program-files: bool, noise: bool, directories: string, refresh: string, updates: bool,
}
export struct ControlBounds { name: string, x: float, y: float, width: float, height: float }

export component SettingsPanel inherits FocusScope {
    in-out property <SettingsDraft> draft;
    in-out property <string> hotkey;
    in property <[string]> hotkey-keys;
    in-out property <int> tab: 0;
    in-out property <length> scroll-y <=> body.content-y;
    in property <string> current-hotkey;
    in property <string> hotkey-error;
    in property <bool> recording;
    in property <bool> busy;
    in property <string> notice;
    in property <string> workspace-notice;
    in property <string> backup-path;
    in property <string> data-directory;
    in property <int> count;
    in property <bool> scanning;
    in property <string> scan-status;
    in property <string> renderer;
    in property <string> product-version;
    in property <[LicenseEntry]> licenses;
    in property <string> update-message;
    in property <string> update-notes;
    in property <string> update-release-label;
    in property <bool> update-busy;
    in property <bool> update-available;
    in property <int> update-progress;
    in property <bool> update-progress-visible;
    in property <string> update-progress-detail;
    private property <bool> licenses-open: false;
    private property <bool> can-save: root.enabled && !root.busy && !root.recording
        && !root.update-busy && !WorkspaceEditorState.busy;
    out property <bool> licenses-expanded: root.licenses-open;
    callback close(); callback save(); callback record(bool); callback manage(); callback groups();
    callback choose-everything();
    callback refresh(); callback backup(); callback open-backups(); callback check-update(); callback install-update(); callback drag();
    focus-on-click: false; focus-on-tab-navigation: false;
    public function focus-panel() { root.focus(); }
    public function show-licenses(open: bool) { root.licenses-open = open; }
    public function save-workspace() {
        if root.can-save && root.tab == 7 { WorkspaceEditorState.save(); }
    }
    changed tab => { root.scroll-y = 0px; root.licenses-open = false; }
    // Export actual component rectangles for the optional visual example;
    // normal application code does not use this observation API.
    public function control-bounds() -> [ControlBounds] {
        return [
            {name: "header", x: 0, y: 0, width: root.width / 1px, height: header.height / 1px},
            {name: "body", x: body.x / 1px, y: body.y / 1px, width: body.width / 1px, height: body.height / 1px},
            {name: "cancel", x: cancel.x / 1px, y: (actions.y + cancel.y) / 1px, width: cancel.width / 1px, height: cancel.height / 1px},
            {name: "save", x: save.x / 1px, y: (actions.y + save.y) / 1px, width: save.width / 1px, height: save.height / 1px},
            {name: "maximum", x: maximum.x / 1px, y: (body.y + body.content-y + maximum.y) / 1px, width: maximum.width / 1px, height: maximum.height / 1px},
            {name: "weight", x: weight.x / 1px, y: (body.y + body.content-y + weight.y) / 1px, width: weight.width / 1px, height: weight.height / 1px},
            {name: "theme", x: theme-select.x / 1px, y: (body.y + body.content-y + theme-select.y) / 1px, width: theme-select.width / 1px, height: theme-select.height / 1px},
            {name: "layout", x: layout-select.x / 1px, y: (body.y + body.content-y + layout-select.y) / 1px, width: layout-select.width / 1px, height: layout-select.height / 1px},
            {name: "directories", x: directories.x / 1px, y: (body.y + body.content-y + directories.y) / 1px, width: directories.width / 1px, height: directories.height / 1px}
        ];
    }
    SurfaceBackground { width: parent.width; height: parent.height; }
    TouchArea { enabled: root.enabled; }
    header := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 82px; background: transparent;
        TouchArea { enabled: root.enabled; pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag(); } } }
        Image { x: 24px; y: 22px; width: 40px; height: 40px; source: @image-url("assets/logo.png"); image-fit: contain; }
        Text { x: 74px; y: 28px; height: 28px; text: "Velo 设置"; color: Theme.fg; font-size: 20px; font-weight: 600; vertical-alignment: center; }
        ActionButton { enabled: root.enabled; x: parent.width - 96px; y: 27px; width: 72px; height: 26px; text: "返回 · Esc"; text-size: 16px; flat: true; activated => { root.close(); } }
    }
    Rectangle { x: 0px; y: 131px; width: parent.width; height: 1px; background: Theme.border; }
    for name[index] in ["常规", "快捷键", "外观", "搜索", "索引", "备份", "关于", "工作台"]: Rectangle {
        x: 24px + index * ((root.width - 48px + 4px) / 8); y: 82px; width: (root.width - 48px - 24px) / 8; height: 35px;
        ActionButton { enabled: root.enabled; width: parent.width; height: parent.height; text: name; text-size: 13px; checked: root.tab == index; flat: true;
            activated => { root.record(false); root.tab = index; body.content-y = 0px; } }
        if root.tab == index: Rectangle { x: parent.width * 0.4; width: parent.width * 0.2; y: 33px; height: 2px; border-radius: 2px; background: Theme.accent; }
    }
    body := ContentScroll {
        enabled: root.enabled; x: 0px; y: 132px; width: parent.width; height: max(1px, parent.height - 200px);
        reserve-scrollbar: true;
        content-height: root.tab == 7 ? 830px : root.tab == 3 ? 482px : root.tab == 2 ? 508px : root.tab == 4 ? 642px : root.tab == 6 ? update-details.y + update-details.height + 24px : root.tab == 5 && root.backup-path != "" ? 510px : 460px;
        Rectangle {
            x: 0px; y: 0px; width: body.visible-width; height: body.content-height;
            private property <length> field-width: self.width - 48px;
            if root.tab == 7: WorkspaceSettings {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                active: root.enabled;
            }
            // y values include the 24px body padding. Explicit
            // controls avoid min-size/stretch changing when hidden tabs exist.
            Rectangle { visible: root.tab == 0; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "启动与显示"; }
                SettingCheck { x: 24px; y: 68px; width: parent.width - 48px; enabled: root.enabled; text: "登录 Windows 时启动 Velo"; checked <=> root.draft.startup; }
                SettingHint { x: 24px; y: 108.8px; width: parent.width - 48px; text: "登录后在后台等待快捷键。请先把可执行文件放到固定位置，再启用此选项。"; }
                SettingCheck { x: 24px; y: 150.4px; width: parent.width - 48px; enabled: root.enabled; text: "按空格键启动选中应用"; checked <=> root.draft.space; }
                SettingHint { x: 24px; y: 191.2px; width: parent.width - 48px; text: "关闭时空格用于输入查询（如 “visual studio”）；开启后空格会直接启动，无法再输入空格。"; }
                SettingLabel { x: 24px; y: 232.8px; text: "最多显示结果"; }
                maximum := SettingField { x: 24px; y: 257.8px; width: 150px; enabled: root.enabled; numeric: true; label: "最多显示结果"; text <=> root.draft.maximum; }
            }
            Rectangle { visible: root.tab == 1; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "全局呼出"; }
                SettingLabel { x: 24px; y: 68px; text: "快捷键"; }
                Rectangle { x: 24px; y: 93px; width: parent.width - 48px; height: 76px; border-radius: 6px; border-width: 1px; border-color: root.recording ? Theme.accent : Theme.border; background: root.recording ? Theme.selected : Theme.field;
                    Glyph { x: 19px; y: 25px; width: 24px; height: 24px; icon-key: "keyboard"; colorize: root.recording ? Theme.accent : Theme.muted; }
                    if !root.recording: HotkeyCaps { x: 57px; y: 22px; width: parent.width - 172px; height: 32px; keys: root.hotkey-keys; }
                    if root.recording: Text { x: 57px; y: 19px; height: 34px; text: "按下组合键…"; font-size: 13px; color: Theme.muted; vertical-alignment: center; }
                    // The action keeps 18px right padding. Its width
                    // changes with the label instead of leaving a fixed gap.
                    Rectangle {
                        x: parent.width - 18px - self.width; y: 31px;
                        width: record-action.preferred-width + (root.recording ? 13px : 0px); height: 14px;
                        record-action := Text { x: root.recording ? 13px : 0px; y: 0px; height: parent.height; text: root.recording ? "录制中" : "点击录制"; font-size: 11px; color: Theme.accent; vertical-alignment: center; }
                        if root.recording: Rectangle { x: 0px; y: 4px; width: 6px; height: 6px; border-radius: 3px; background: Theme.accent;
                            private property <float> pulse: Theme.presented && !Theme.reduce-motion ? (1 - cos(360deg * animation-tick()/1.2s)) / 2 : 0;
                            Rectangle { x: -parent.pulse * 4px; y: -parent.pulse * 4px; width: 6px + parent.pulse * 8px; height: self.width; border-radius: self.width / 2; background: Theme.accent-line; }
                            Rectangle { x: 0px; y: 0px; width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; }
                        }
                    }
                    TouchArea { enabled: root.enabled; clicked => { root.record(!root.recording); } }
                }
                SettingHint { x: 24px; y: 179px; width: parent.width - 48px; text: root.recording ? "请按组合键；Esc 取消，Tab 离开。" : root.hotkey-error != "" ? root.hotkey-error : "点击录制，按下你想使用的组合键。"; }
                SettingCheck { x: 24px; y: 223px; width: parent.width - 48px; enabled: root.enabled; checked <=> root.draft.fullscreen; text: "全屏时禁止快捷键呼出"; }
                SettingHint { x: 24px; y: 263.8px; width: parent.width - 48px; text: "当前前台应用全屏时不响应呼出快捷键，仍可通过托盘打开 Velo。"; }
                SettingHint { x: 24px; y: 305.4px; width: parent.width - 48px; text: "支持 Ctrl、Alt、Shift、Win 配合字母、数字、Space、Enter、Tab 或 F1–F24。系统保留的组合键可能无法录制或注册；若快捷键被占用，保存时会提示并保留原快捷键。"; }
                SettingHint { x: 24px; y: 368.6px; width: parent.width - 48px; text: "托盘图标常驻通知区域：左键单击显示或隐藏启动器，右键菜单可打开启动器、设置或退出。"; }
            }
            Rectangle { visible: root.tab == 2; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "界面主题"; }
                ThemePreview { x: 24px; y: 68px; width: parent.width - 48px; theme: root.draft.theme; }
                SettingLabel { x: 24px; y: 264px; text: "主题"; }
                theme-select := SettingSelect { x: 24px; y: 289px; width: parent.width - 48px; enabled: root.enabled; label: "主题"; options: ["跟随系统", "浅色", "深色"]; descriptions: ["与 Windows 的外观设置保持一致", "明亮、清晰的日间外观", "柔和、低亮度的深色外观"]; current-index <=> root.draft.theme; above: true; }
                SettingLabel { x: 24px; y: 353px; text: "候选项排列"; }
                layout-select := SettingSelect { x: 24px; y: 378px; width: parent.width - 48px; enabled: root.enabled; label: "候选项排列"; options: ["列表", "网格"]; descriptions: ["逐行显示应用名称与路径", "图标在上、名称在下，应用与系统快捷按搜索排名统一排列"]; current-index <=> root.draft.layout; above: true; }
                SettingHint { x: 24px; y: 442px; width: parent.width - 48px; text: "网格模式支持四个方向键选择；两种排列均可右键打开候选项菜单。"; }
            }
            Rectangle { visible: root.tab == 3; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "匹配与排序"; }
                SettingCheck { x: 24px; y: 68px; width: parent.width - 48px; enabled: root.enabled; text: "模糊搜索与单字拼写容错"; checked <=> root.draft.fuzzy; }
                SettingLabel { x: 24px; y: 108.8px; text: "历史权重"; }
                weight := SettingField { x: 24px; y: 133.8px; width: 150px; enabled: root.enabled; text <=> root.draft.weight; label: "历史权重"; }
                SettingHint { x: 24px; y: 190.8px; width: parent.width - 48px; text: "0 表示关闭历史加权，1 为默认值。启动次数、最近使用和相同查询的选择会影响排序。数据仅保存在本机。"; }
                SettingHeading { x: 24px; y: 246px; text: "文件搜索"; }
                SettingCheck { x: 24px; y: 290px; width: parent.width - 48px; enabled: root.enabled; text: "启用 Everything"; checked <=> root.draft.everything; }
                SettingHint { x: 24px; y: 330px; width: parent.width - 48px; text: "按 Tab 搜索文件和文件夹。需安装并运行 Everything；关闭后释放 Velo 查询资源。"; }
                SettingLabel { x: 24px; y: 380px; text: "便携版程序路径（可留空）"; }
                SettingField { x: 24px; y: 405px; width: parent.width - 128px; enabled: root.enabled; text <=> root.draft.everything-executable; label: "Everything 程序路径"; placeholder: "自动查找已安装的 Everything"; }
                ActionButton { x: parent.width - 96px; y: 405px; width: 72px; height: 33px; enabled: root.enabled; text: "选择…"; activated => { root.choose-everything(); } }
                SettingHint { x: 24px; y: 450px; width: parent.width - 48px; text: "保存后生效。Everything 独立运行，其内存由程序自身管理。"; }
            }
            Rectangle { visible: root.tab == 4; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "应用来源"; }
                ActionButton { x: 24px; y: 68px; width: 117px; height: 33px; text: "管理自定义项目"; text-size: 13px; radius: 6px; enabled: root.enabled; activated => { root.manage(); } }
                ActionButton { x: 153px; y: 68px; width: 110px; height: 33px; text: "启动组合"; text-size: 13px; radius: 6px; enabled: root.enabled; activated => { root.groups(); } }
                SettingHint { x: 24px; y: 109px; width: parent.width - 48px; text: "单独添加或删除扫描范围外的应用，重启后仍可搜索；无需添加整个目录。"; }
                SettingHint { x: 24px; y: 150.6px; width: parent.width - 48px; text: "默认扫描开始菜单、桌面和 Windows Apps。"; }
                SettingCheck { x: 24px; y: 192.2px; width: parent.width - 48px; enabled: root.enabled; text: "同时扫描 Program Files / Program Files (x86)"; checked <=> root.draft.program-files; }
                SettingCheck { x: 24px; y: 233px; width: parent.width - 48px; enabled: root.enabled; text: "隐藏卸载、帮助、更新等辅助项"; checked <=> root.draft.noise; }
                SettingHint { x: 24px; y: 273.8px; width: parent.width - 48px; text: "同时合并重名副本（同一个应用的多份快捷方式只保留一条），并跳过 Git\\usr\\bin、Windows Kits 等深处的组件程序。关闭后恢复完整扫描与全部条目。"; }
                SettingLabel { x: 24px; y: 337px; text: "自定义目录（每行一个绝对路径）"; }
                directories := SettingField { x: 24px; y: 362px; width: parent.width - 48px; height: 71px; enabled: root.enabled; multiline: true; text <=> root.draft.directories; label: "自定义索引目录"; placeholder: "D:\\Apps"; }
                SettingLabel { x: 24px; y: 453px; text: "后台刷新间隔（分钟）"; }
                SettingField { x: 24px; y: 478px; width: 150px; enabled: root.enabled; numeric: true; text <=> root.draft.refresh; label: "后台刷新间隔"; }
                ActionButton { x: 24px; y: 535px; width: 130px; height: 33px; text: "立即刷新现有索引"; text-size: 13px; enabled: root.enabled; activated => { root.refresh(); } }
                SettingHint { x: 24px; y: 576px; width: parent.width - 48px; text: root.count + " 个应用 · " + root.scan-status; }
            }
            Rectangle { visible: root.tab == 5; width: parent.width; height: parent.height;
                SettingHeading { x: 24px; y: 24px; text: "配置备份"; }
                SettingHint { x: 24px; y: 68px; width: parent.width - 48px; text: "保留已保存的快捷键、主题、搜索偏好和索引目录等设置。若刚修改了设置，请先点击“保存设置”，再创建备份。"; }
                ActionButton { x: 24px; y: 131.2px; width: 78px; height: 33px; text: "立即备份"; text-size: 13px; primary: true; enabled: root.enabled && !root.busy && !root.update-busy; activated => { root.backup(); } }
                ActionButton { x: 112px; y: 131.2px; width: 104px; height: 33px; text: "打开备份目录"; text-size: 13px; enabled: root.enabled && !root.busy; activated => { root.open-backups(); } }
                SettingHint { x: 24px; y: 178.2px; width: parent.width - 48px; text: root.backup-path == "" ? "备份位于数据目录的 backups 文件夹，每次创建独立的 JSON 文件，可复制到其他位置保管。" : "备份已保存：\n" + root.backup-path; }
                SettingHeading { x: 24px; y: root.backup-path == "" ? 219.8px : 263px; text: "更新时保留配置"; }
                SettingHint { x: 24px; y: root.backup-path == "" ? 263.8px : 307px; width: parent.width - 48px; text: "安装更新前会自动备份已保存的配置；备份失败时停止安装。更新后继续使用原有设置，新选项使用默认值。"; }
                SettingHint { x: 24px; y: root.backup-path == "" ? 305.4px : 348.6px; width: parent.width - 48px; text: "需要恢复时，先完全退出 Velo，将备份复制到数据目录并命名为 config.json，然后重新启动。此备份仅包含设置，自定义项目、固定项和历史记录请另行保留数据目录中的对应文件。"; }
            }
            Rectangle { visible: root.tab == 6; width: parent.width; height: parent.height;
                private property <length> expanded-offset: root.licenses-open ? root.licenses.length * 232px + 180px : 0px;
                SettingHeading { x: 24px; y: 24px; text: "版本与更新"; }
                Rectangle { x: 24px; y: 68px; width: 145px; height: 17px;
                    accessible-role: button; accessible-label: "图标与开源许可"; accessible-expandable: true; accessible-expanded: root.licenses-open;
                    accessible-action-default => { root.licenses-open = !root.licenses-open; }
                    accessible-action-expand => { root.licenses-open = true; }
                    forward-focus: disclosure-focus;
                    // Draw the disclosure mark as geometry; Segoe UI fallback
                    // did not supply the previous Unicode triangle on all paths.
                    Path { x: 0px; y: 4px; width: 8px; height: 8px; fill: Theme.accent;
                        commands: root.licenses-open ? "M 0 1 L 8 1 L 4 7 Z" : "M 1 0 L 7 4 L 1 8 Z";
                    }
                    Text { x: 13px; width: parent.width - 13px; height: parent.height; text: "图标与开源许可"; color: Theme.accent; font-size: 13px; }
                    disclosure-focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.licenses-open = !root.licenses-open; return accept; } return reject; } }
                    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { disclosure-focus.focus(); root.licenses-open = !root.licenses-open; } }
                }
                if root.licenses-open: Rectangle { x: 24px; y: 93px; width: parent.width - 48px; height: parent.expanded-offset;
                    for license[index] in root.licenses: Rectangle { x: 0px; y: index * 232px; width: parent.width; height: 232px;
                        SettingHint { x: 0px; y: 0px; text: license.title; width: parent.width; }
                        SettingField { x: 0px; y: 35px; width: parent.width; height: 180px; enabled: root.enabled; multiline: true; text: license.text; read-only: true; label: license.title; }
                    }
                    Rectangle { x: 0px; y: root.licenses.length * 232px; width: parent.width; height: 160px; clip: true;
                        AboutSlint { width: parent.width; height: parent.height; }
                    }
                }
                SettingHint { x: 24px; y: 93px + parent.expanded-offset; width: parent.width - 48px; text: "当前版本 " + root.product-version + "。更新检查只读取 GitHub 发布页的版本信息，不上传任何本机数据。"; }
                SettingCheck { x: 24px; y: 134.6px + parent.expanded-offset; width: parent.width - 48px; enabled: root.enabled; text: "启动后自动检查更新"; checked <=> root.draft.updates; }
                SettingHint { x: 24px; y: 175.4px + parent.expanded-offset; width: parent.width - 48px; text: "自动检查只提示新版本，不会在后台下载或替换程序；下载与安装始终需要你确认。"; }
                SettingHint { x: 24px; y: 217px + parent.expanded-offset; width: parent.width - 48px; text: "安装前自动备份已保存的配置，更新后保留原有设置。也可在“备份”中提前手动备份。"; }
                ActionButton { x: 24px; y: 258.6px + parent.expanded-offset; width: 104px; height: 33px; text: root.update-busy ? "更新处理中…" : "立即检查更新"; text-size: 13px; enabled: root.enabled && !root.update-busy && !root.busy; activated => { root.check-update(); } }
                if root.update-available: ActionButton { x: 138px; y: 258.6px + parent.expanded-offset; width: 126px; height: 33px; text: "下载并安装"; primary: true; text-size: 13px; enabled: root.enabled && !root.update-busy && !root.busy && !root.recording; activated => { root.install-update(); } }
                update-details := Rectangle {
                    x: 24px; y: 311px + parent.expanded-offset;
                    // Keep measurement independent of whether the outer scrollbar is visible.
                    width: max(1px, root.width - 63px);
                    height: release-notes.visible ? release-notes.y + release-notes.height : track.visible ? track.y + track.height : status.height;
                    status := Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: max(message.preferred-height, detail.preferred-height);
                        message := Text {
                            x: 0px; y: 0px;
                            width: max(1px, parent.width - (detail.width > 0px ? detail.width + 12px : 0px));
                            height: self.preferred-height;
                            text: root.update-message; wrap: word-wrap; font-size: 13px; color: Theme.muted;
                        }
                        detail := Text {
                            x: parent.width - self.width; y: 0px;
                            width: root.update-progress-detail == "" ? 0px : min(parent.width * 0.6, self.preferred-width);
                            height: self.preferred-height;
                            text: root.update-progress-detail; font-size: 12px; color: Theme.fg; overflow: elide; horizontal-alignment: right;
                        }
                    }
                    track := Rectangle {
                        visible: root.update-progress-visible;
                        y: status.height + 8px; width: parent.width; height: 6px;
                        border-radius: 3px; background: Theme.border;
                        accessible-role: progress-indicator; accessible-label: root.update-message;
                        accessible-value: root.update-progress-detail;
                        Rectangle {
                            private property <bool> indeterminate: root.update-progress < 0;
                            private property <float> sweep: indeterminate && Theme.presented && !Theme.reduce-motion ? Math.mod(animation-tick() / 1.4s, 1) : 0.5;
                            x: indeterminate ? (parent.width - self.width) * sweep : 0px;
                            width: parent.width * (indeterminate ? 0.24 : clamp(root.update-progress / 100.0, 0, 1));
                            height: parent.height; border-radius: 3px; background: Theme.accent;
                        }
                    }
                    release-notes := Rectangle {
                        visible: root.update-notes != "";
                        y: (track.visible ? track.y + track.height : status.height) + 18px;
                        width: parent.width; height: notes-text.y + notes-text.height + 16px;
                        border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.field;
                        Text { x: 16px; y: 14px; text: "更新日志"; font-size: 14px; font-weight: 600; color: Theme.fg; }
                        Text {
                            x: parent.width - self.width - 16px; y: 15px; width: min(notes-text.width * 0.65, self.preferred-width);
                            text: root.update-release-label; color: Theme.muted; font-size: 12px; overflow: elide; horizontal-alignment: right;
                        }
                        notes-text := Text {
                            x: 16px; y: 39px; width: max(1px, parent.width - 32px); height: self.preferred-height;
                            text: root.update-notes; wrap: word-wrap; line-height-factor: 1.3; font-size: 13px; color: Theme.fg;
                        }
                    }
                }
            }
        }
    }
    actions := Rectangle {
        x: 0px; y: parent.height - 68px; width: parent.width; height: 68px; background: Theme.surface;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
        SettingHint { x: 24px; y: 12px; width: parent.width - 210px; height: 44px;
            text: root.tab == 7 ? root.workspace-notice : root.notice; overflow: elide; }
        cancel := ActionButton { x: parent.width - 182px; y: 16px; width: 58px; height: 37px; text: "取消"; text-size: 16px; radius: 6px; enabled: root.enabled && !root.busy && !WorkspaceEditorState.busy; activated => { root.close(); } }
        save := ActionButton { x: parent.width - 114px; y: 16px; width: 90px; height: 37px; text: root.busy || WorkspaceEditorState.busy ? "保存中…" : "保存设置"; text-size: 16px; radius: 6px; primary: true;
            enabled: root.can-save;
            activated => { if root.tab == 7 { root.save-workspace(); } else { root.save(); } }
        }
    }
}
