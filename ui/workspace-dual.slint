import { ActionButton, Glyph, Theme } from "components.slint";

export struct WorkspaceTile {
    label: string,
    glyph: string,
    direction: string,
    enabled: bool,
}

export component WorkspaceTileFace inherits Rectangle {
    in property <WorkspaceTile> tile;
    in property <bool> current;
    in property <bool> focused;
    in property <bool> hovered;
    in property <bool> editing;
    private property <bool> empty: root.tile.label == "";
    border-radius: 9px;
    border-width: root.current || root.focused ? 1.5px : 1px;
    border-color: root.focused || root.current ? Theme.accent : root.hovered ? Theme.accent-line
        : root.empty && !root.editing ? Theme.bg.mix(Theme.border, 0.55) : Theme.border;
    background: root.current ? Theme.selected : root.hovered ? Theme.hover
        : root.empty && !root.editing ? Theme.bg.mix(Theme.field, 0.2) : Theme.surface;

    if !root.empty || root.editing: Glyph {
        x: (parent.width - self.width) / 2;
        y: root.empty ? (parent.height - self.height) / 2 : (parent.height - 39px) / 2;
        width: 20px; height: 20px;
        icon-key: root.empty ? "plus" : root.tile.glyph;
        colorize: root.tile.enabled || root.editing ? Theme.accent : Theme.muted;
    }
    if !root.empty: Text {
        x: 4px; y: (parent.height - 39px) / 2 + 23px; width: parent.width - 8px; height: 16px;
        text: root.tile.label;
        font-size: 12px; font-weight: root.current ? 600 : 500;
        color: root.tile.enabled ? Theme.fg : Theme.muted;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if root.tile.direction != "": Path {
        x: root.empty && !root.editing ? (parent.width - self.width) / 2 : parent.width - 19px;
        y: root.empty && !root.editing ? (parent.height - self.height) / 2 : 5px;
        width: root.empty && !root.editing ? 16px : 12px;
        height: self.width;
        viewbox-width: 14; viewbox-height: 14;
        commands: root.tile.direction;
        fill: transparent; stroke: root.current ? Theme.accent : Theme.muted;
        stroke-width: 1.2px; stroke-line-cap: round; stroke-line-join: round;
    }
}

component PanelMatrix inherits Rectangle {
    in property <[WorkspaceTile]> tiles;
    in property <int> columns;
    in property <length> cell-width;
    in-out property <string> detail;
    callback activate(int);
    for tile[index] in root.tiles: WorkspaceTileFace {
        x: (parent.width - root.columns * (root.cell-width + 6px) + 6px) / 2
            + Math.mod(index, root.columns) * (root.cell-width + 6px);
        y: Math.floor(index / root.columns) * 57px;
        width: root.cell-width; height: 51px;
        tile: tile;
        focused: focus.has-focus;
        hovered: touch.has-hover && tile.enabled;
        current: touch.pressed;
        focus := FocusScope {
            enabled: tile.enabled;
            changed has-focus => {
                if self.has-focus { root.detail = tile.label; }
                else if root.detail == tile.label { root.detail = ""; }
            }
            key-pressed(event) => {
                if event.text == "\n" || event.text == " " {
                    root.activate(index);
                    return accept;
                }
                return reject;
            }
        }
        touch := TouchArea {
            enabled: tile.label != "";
            mouse-cursor: tile.enabled ? pointer : default;
            changed has-hover => {
                if self.has-hover { root.detail = tile.enabled ? tile.label : tile.label + " · 不可用"; }
                else if root.detail == tile.label || root.detail == tile.label + " · 不可用" { root.detail = ""; }
            }
            clicked => { if tile.enabled { root.activate(index); } }
        }
        accessible-role: button;
        accessible-label: tile.label;
        accessible-action-default => { if tile.enabled { root.activate(index); } }
    }
}

component HubButton inherits ActionButton {
    in-out property <string> detail;
    flat: true;
    width: 36px; height: 34px;
    private property <bool> pointing: (self.icon-key != "" || !self.show-text)
        && (self.has-hover || self.has-keyboard-focus);
    changed pointing => {
        if self.pointing { root.detail = root.text; }
        else if root.detail == root.text { root.detail = ""; }
    }
}

export component WorkspacePanel inherits Rectangle {
    in property <[WorkspaceTile]> global-tiles;
    in property <[WorkspaceTile]> context-tiles;
    in property <int> global-columns: 3;
    in property <int> context-columns: 3;
    in property <string> context-title;
    in property <string> context-source;
    in property <string> context-glyph: "apps";
    callback activate(int);
    callback drag-requested();
    private property <string> detail;
    private property <int> largest: max(root.global-columns, root.context-columns);
    private property <length> cell-width: (self.width - 24px - 6px * (self.largest - 1)) / self.largest;
    background: Theme.bg;
    border-radius: 12px; border-width: 1px; border-color: Theme.window-border;

    // The close button is painted and receives pointer events above this area.
    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: 34px;
        mouse-cursor: move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-requested();
            }
        }
    }
    Text { x: 13px; y: 10px; width: 90px; height: 17px; text: "全局动作"; color: Theme.fg; font-size: 13px; font-weight: 600; }
    Text {
        x: 100px; y: 10px; width: parent.width - 156px; height: 17px;
        text: root.detail; color: Theme.muted; font-size: 11px;
        vertical-alignment: center; horizontal-alignment: right; overflow: elide;
    }
    ActionButton {
        x: parent.width - 50px; y: 4px; width: 39px; height: 27px;
        text: "关闭"; text-size: 11px; flat: true;
        activated => { root.activate(-5); }
    }
    PanelMatrix {
        x: 12px; y: 34px; width: parent.width - 24px; height: 108px;
        tiles: root.global-tiles; columns: root.global-columns; cell-width: root.cell-width;
        detail <=> root.detail;
        activate(index) => { root.activate(index); }
    }
    Rectangle {
        x: 12px; y: 151px; width: parent.width - 24px; height: 42px;
        border-radius: 10px; border-width: 1px; border-color: Theme.accent-line;
        background: Theme.field;
        HubButton { x: 4px; y: 4px; width: 32px; text: "打开启动器"; show-text: false; detail <=> root.detail; activated => { root.activate(-1); } }
        Image { x: 7px; y: 7px; width: 26px; height: 28px; source: @image-url("assets/logo.png"); image-fit: contain; }
        Rectangle { x: 37px; y: 9px; width: 1px; height: 24px; background: Theme.border; }
        Glyph { x: 41px; y: 13px; width: 16px; height: 16px; icon-key: root.context-glyph; }
        Text {
            x: 61px; y: 0px; width: actions.x - self.x - 5px; height: parent.height;
            text: root.context-title; color: Theme.fg; font-size: 12px;
            font-weight: 600; vertical-alignment: center; overflow: elide;
        }
        actions := HorizontalLayout {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width; height: 34px; spacing: 5px;
            HubButton {
                width: 62px; flat: false; text: "编辑全局"; text-size: 12px;
                activated => { root.activate(-2); }
            }
            HubButton {
                width: 62px; flat: false; text: "编辑应用"; text-size: 12px;
                activated => { root.activate(-3); }
            }
            HubButton {
                width: 32px; text: "手势设置"; icon-key: "settings"; detail <=> root.detail;
                activated => { root.activate(-4); }
            }
        }
    }
    Text { x: 13px; y: 203px; width: 90px; height: 17px; text: "应用动作"; color: Theme.fg; font-size: 13px; font-weight: 600; }
    Text {
        x: 108px; y: 203px; width: parent.width - 121px; height: 17px;
        text: root.context-source; color: Theme.muted; font-size: 11px;
        vertical-alignment: center; horizontal-alignment: right; overflow: elide;
    }
    PanelMatrix {
        x: 12px; y: 228px; width: parent.width - 24px; height: 108px;
        tiles: root.context-tiles; columns: root.context-columns; cell-width: root.cell-width;
        detail <=> root.detail;
        activate(index) => { root.activate(index + 10); }
    }
}

export component WorkspaceGesturePad inherits Rectangle {
    in property <[WorkspaceTile]> tiles;
    in property <bool> expanded;
    in property <int> selected: -1;
    in property <string> context-title;
    private property <length> cell-width: (self.width - 32px) / 3;
    private property <length> cell-height: (self.height - 32px) / 3;
    if root.expanded: Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 12px; border-width: 1px; border-color: Theme.window-border; background: Theme.bg;
        for tile[index] in root.tiles: WorkspaceTileFace {
            private property <int> cell: index < 4 ? index : index + 1;
            x: 10px + Math.mod(self.cell, 3) * (root.cell-width + 6px);
            y: 10px + Math.floor(self.cell / 3) * (root.cell-height + 6px);
            width: root.cell-width; height: root.cell-height;
            tile: tile;
            current: index == root.selected;
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.cell-width; height: root.cell-height;
        border-radius: 12px; border-width: 1px;
        border-color: Theme.window-border;
        background: Theme.field;
        Image {
            x: (parent.width - self.width) / 2; y: 0px; width: 33px; height: 32px;
            source: @image-url("assets/logo.png"); image-fit: contain;
        }
        Text {
            x: 3px; y: 28px; width: parent.width - 6px; height: 16px;
            text: root.selected >= 0 ? "松开执行" : "松开取消";
            color: root.selected >= 0 ? Theme.accent : Theme.fg; font-size: 11px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            x: 4px; y: 44px; width: parent.width - 8px; height: 14px;
            text: root.context-title; color: Theme.muted; font-size: 10px;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
    }
}
