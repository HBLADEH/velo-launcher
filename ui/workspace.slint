import { Theme } from "components.slint";
import { WorkspaceTile, WorkspacePanel, WorkspaceGesturePad } from "workspace-dual.slint";
export { WorkspaceTile } from "workspace-dual.slint";

export component WorkspaceWindow inherits Window {
    title: "Velo Workspace";
    icon: @image-url("assets/logo.png");
    no-frame: true;
    always-on-top: true;
    preferred-width: root.board-width * 1px;
    preferred-height: root.board-height * 1px;
    default-font-family: "Segoe UI";
    background: root.pad && !root.pad-expanded ? Theme.field : Theme.bg;

    in-out property <bool> dark-theme <=> Theme.dark;
    in-out property <bool> reduce-motion <=> Theme.reduce-motion;

    in property <int> board-width: 320;
    in property <int> board-height: 348;
    in property <bool> pad;
    in property <bool> pad-expanded;
    in property <int> pad-selection: -1;
    in property <[WorkspaceTile]> global-tiles;
    in property <[WorkspaceTile]> context-tiles;
    in property <int> global-columns: 3;
    in property <int> context-columns: 3;
    in property <string> context-title;
    in property <string> context-source;
    in property <string> context-glyph: "apps";
    callback panel-activate(int);
    callback panel-drag-requested();

    if !root.pad: WorkspacePanel {
        width: parent.width; height: parent.height;
        global-tiles: root.global-tiles;
        context-tiles: root.context-tiles;
        global-columns: root.global-columns;
        context-columns: root.context-columns;
        context-title: root.context-title; context-source: root.context-source; context-glyph: root.context-glyph;
        activate(index) => { root.panel-activate(index); }
        drag-requested => { root.panel-drag-requested(); }
    }

    if root.pad: WorkspaceGesturePad {
        width: parent.width; height: parent.height;
        tiles: root.context-tiles; expanded: root.pad-expanded; selected: root.pad-selection;
        context-title: root.context-title;
    }
}
